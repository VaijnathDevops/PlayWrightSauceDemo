# Copy this file to .env (repo root or TestProject1/) and fill in real values for local test runs.
# .env is git-ignored — never commit real credentials.
#
# In Azure Pipelines, do NOT use a .env file: create SECRET pipeline variables (or a variable group)
# with these exact names instead, and map them to environment variables on the test step.
# See azure-pipelines.yml.

# SauceDemo's published "successful login" demo account.
# NOTE: this is SauceDemo's own well-known demo value, not independently verified against the
# live site this session (see TestCases/Login.md assumptions) — confirm if login behavior differs.
SAUCE_STANDARD_USERNAME=standard_user

# SauceDemo's published locked-out demo account, used to test the lockout flow.
SAUCE_LOCKED_OUT_USERNAME=locked_out_user

# Password shared by SauceDemo's published demo accounts.
SAUCE_PASSWORD=secret_sauce
